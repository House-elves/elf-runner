[Unit]
Description=Elf Desk runner (agents, gh writes, mvnpm checks)
Wants=network-online.target
After=network-online.target elf-desk.service

[Service]
Type=simple
# claude, gh, git, mvnpm-dependabot, bwrap: the same PATH a login shell has.
Environment=PATH=%h/.local/bin:%h/.jbang/bin:%h/.sdkman/candidates/jbang/current/bin:%h/.sdkman/candidates/java/current/bin:%h/.sdkman/candidates/maven/current/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.sdkman/candidates/java/current/bin/java -Xmx256m -jar %h/.local/share/elf-runner/bin/elf-runner.jar
Restart=on-failure
RestartSec=10
# Agents run as child processes: stopping the runner stops them too.
KillMode=control-group
# Agents' builds and tests share this unit's memory. Above MemoryHigh the kernel reclaims and slows them; at
# MemoryMax it kills a process here rather than something elsewhere on the desktop. Either way only that process
# dies (OOMPolicy=continue): the runner and the other agents keep going. The default (stop) took the whole runner
# and every running agent down on 2026-10-15.
MemoryHigh=6G
MemoryMax=8G
OOMPolicy=continue

[Install]
WantedBy=default.target
